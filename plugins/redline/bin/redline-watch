#!/usr/bin/env bash
# Watch the sidecar for new pending redlines. Emits one stdout line per newly
# seen pending id (never re-emits the same id), so it can be consumed by a
# Monitor loop where each line is one wake-up.
#
# Usage:
#   redline-watch                         # all pending, all origins
#   redline-watch https://example.com     # filter by origin
#   redline-watch --project firstlanding
#   redline-watch --interval 2            # poll interval seconds (default 3)
set -e

PORT="${REDLINE_PORT:-7878}"
BASE="http://127.0.0.1:$PORT"
INTERVAL=3
ORIGIN=""
PROJECT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --interval) INTERVAL="$2"; shift 2 ;;
    --interval=*) INTERVAL="${1#*=}"; shift ;;
    --project) PROJECT="$2"; shift 2 ;;
    --project=*) PROJECT="${1#*=}"; shift ;;
    --origin) ORIGIN="$2"; shift 2 ;;
    --origin=*) ORIGIN="${1#*=}"; shift ;;
    http://*|https://*) ORIGIN="$1"; shift ;;
    -h|--help)
      sed -n '2,9p' "$0"
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done

if ! command -v jq >/dev/null; then
  echo "redline-watch requires jq" >&2
  exit 1
fi

urlenc() { printf %s "$1" | jq -sRr @uri; }

q="status=pending"
[ -n "$ORIGIN" ]  && q="$q&origin=$(urlenc "$ORIGIN")"
[ -n "$PROJECT" ] && q="$q&project=$(urlenc "$PROJECT")"

# Track ids we've already announced this run so each redline triggers exactly
# one Monitor notification, even though the item lingers in /redlines?status=pending
# until Claude acks it.
SEEN_FILE="$(mktemp -t redline-watch.XXXXXX)"
trap 'rm -f "$SEEN_FILE"' EXIT

echo "watching $BASE (interval ${INTERVAL}s, filter: ${q})" >&2

while true; do
  if ! curl -sf "$BASE/health" >/dev/null 2>&1; then
    echo "sidecar down at $BASE — retrying" >&2
    sleep "$INTERVAL"
    continue
  fi

  ids=$(curl -s "$BASE/redlines?$q" | jq -r '.[].id' 2>/dev/null || true)
  for id in $ids; do
    if ! grep -qxF "$id" "$SEEN_FILE" 2>/dev/null; then
      echo "$id"
      echo "$id" >> "$SEEN_FILE"
    fi
  done

  sleep "$INTERVAL"
done
