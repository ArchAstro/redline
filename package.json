{
  "name": "@archastro/redline",
  "version": "0.2.4",
  "description": "Highlight live web UI, leave redlines, pipe them into Claude Code / Codex. Chrome extension + local sidecar + multi-harness plugin.",
  "bin": {
    "redline": "setup/redline.js",
    "redline-agent-setup": "setup/redline-agent-setup.js",
    "redline-extension-status": "setup/redline-agent-setup.js",
    "redline-sidecar": ".claude-plugins/redline/bin/redline-sidecar",
    "redline-pull": ".claude-plugins/redline/bin/redline-pull",
    "redline-watch": ".claude-plugins/redline/bin/redline-watch",
    "redline-tail": ".claude-plugins/redline/bin/redline-tail",
    "redline-clear": ".claude-plugins/redline/bin/redline-clear"
  },
  "files": [
    "setup/",
    ".claude-plugins/",
    ".claude-plugin/",
    "plugins/",
    "extension/",
    "docs/assets/"
  ],
  "scripts": {
    "check:syntax": "node -c plugins/redline/server.js && node -c .claude-plugins/redline/server.js && node -c setup/redline-agent-setup.js && node -c setup/redline.js && node -c setup/sync-versions.js && node -c extension/auth.js && node -c extension/background.js && node -c extension/content.js && node -c extension/popup.js",
    "check:versions": "node setup/sync-versions.js --check",
    "test": "node --test tests/*.test.js",
    "release": "npx changeset publish",
    "version": "npx changeset version && node setup/sync-versions.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "read-yaml-file": {
      "js-yaml": "^3.15.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchAstro/redline.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "Apache-2.0",
  "author": "ArchAstro",
  "keywords": [
    "claude-code",
    "codex",
    "chrome-extension",
    "redline",
    "ui-review"
  ]
}
