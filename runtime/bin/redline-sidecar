#!/usr/bin/env bash
set -e

SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  link="$(readlink "$SCRIPT")"
  case "$link" in
    /*) SCRIPT="$link" ;;
    *)  SCRIPT="$(cd "$(dirname "$SCRIPT")" && pwd)/$link" ;;
  esac
done
HERE="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
LIFECYCLE="$HERE/lib/sidecar-lifecycle.js"
COMMAND="${1:-start}"

case "$COMMAND" in
  start|stop|restart|status|logs|foreground|fg|run|-h|--help|help) ;;
  *) echo "unknown subcommand: $COMMAND (try --help)" >&2; exit 1 ;;
esac

SUPERVISOR_PID=""

terminate_supervisor() {
  local exit_code="$1" attempt=0
  trap - HUP INT TERM
  if [ -n "$SUPERVISOR_PID" ] && kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
    kill -TERM "$SUPERVISOR_PID" 2>/dev/null || true
    while kill -0 "$SUPERVISOR_PID" 2>/dev/null && [ "$attempt" -lt 20 ]; do
      attempt=$((attempt + 1))
      sleep 0.05
    done
    if kill -0 "$SUPERVISOR_PID" 2>/dev/null; then kill -KILL "$SUPERVISOR_PID" 2>/dev/null || true; fi
    wait "$SUPERVISOR_PID" 2>/dev/null || true
  fi
  exit "$exit_code"
}

trap 'terminate_supervisor 129' HUP
trap 'terminate_supervisor 130' INT
trap 'terminate_supervisor 143' TERM

node "$LIFECYCLE" "$@" &
SUPERVISOR_PID=$!
if wait "$SUPERVISOR_PID"; then
  exit 0
else
  exit $?
fi
