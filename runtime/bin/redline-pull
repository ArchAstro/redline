#!/usr/bin/env bash
# Pull pending redlines from the local sidecar, print as markdown, ack each.
#
# Usage:
#   redline-pull                       # all pending, all origins
#   redline-pull https://example.com   # filter by origin
#   redline-pull --project my-app
#   redline-pull --no-ack              # peek without consuming
set -e
set -o pipefail

PORT="${REDLINE_PORT:-7878}"
BASE="http://127.0.0.1:$PORT"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
HTTP_CLIENT="$HERE/lib/cli-http.js"
ACK=1
ORIGIN=""
PROJECT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --no-ack) ACK=0; shift ;;
    --project) PROJECT="$2"; shift 2 ;;
    --project=*) PROJECT="${1#*=}"; shift ;;
    --origin) ORIGIN="$2"; shift 2 ;;
    --origin=*) ORIGIN="${1#*=}"; shift ;;
    http://*|https://*) ORIGIN="$1"; shift ;;
    -h|--help)
      sed -n '2,8p' "$0"
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done

if ! command -v jq >/dev/null; then
  echo "redline-pull requires jq" >&2
  exit 1
fi

if ! node "$HTTP_CLIENT" "$PORT" GET "/health" >/dev/null; then
  echo "redline sidecar not reachable at $BASE" >&2
  echo "start it with: redline-sidecar start" >&2
  exit 1
fi

urlenc() { printf %s "$1" | jq -sRr @uri; }

untrusted_block() {
  label="$1"
  value="$2"
  fence='```'
  while [[ "$value" == *"$fence"* ]]; do
    fence="${fence}\`"
  done
  printf '**%s (untrusted page data):**\n\n%s\n%s\n%s\n\n' "$label" "$fence" "$value" "$fence"
}

q="status=pending"
[ -n "$ORIGIN" ]  && q="$q&origin=$(urlenc "$ORIGIN")"
[ -n "$PROJECT" ] && q="$q&project=$(urlenc "$PROJECT")"

items=$(node "$HTTP_CLIENT" "$PORT" GET "/redlines?$q")
count=$(echo "$items" | jq 'length')

if [ "$count" = "0" ]; then
  echo "No pending redlines."
  exit 0
fi

echo "# Pending Redlines ($count item$([ "$count" = "1" ] || echo s))"
echo

echo "$items" | jq -c '.[]' | while IFS= read -r item; do
  id=$(echo "$item" | jq -r '.id')
  url=$(echo "$item" | jq -r '.url // ""')
  title=$(echo "$item" | jq -r '.title // ""')
  selected=$(echo "$item" | jq -r '.selected_text // ""')
  comment=$(echo "$item" | jq -r '.comment // ""')
  selector=$(echo "$item" | jq -r '.context.selector // ""')
  surrounding=$(echo "$item" | jq -r '.context.surrounding_text // ""')
  project=$(echo "$item" | jq -r '.project // ""')
  screenshot=$(echo "$item" | jq -r '.screenshot_id // ""')
  rect=$(echo "$item" | jq -c '.rect // null')

  echo "## $id"
  [ -n "$project" ] && untrusted_block "project" "$project"
  untrusted_block "page title" "$title"
  untrusted_block "page URL" "$url"
  [ -n "$selector" ] && untrusted_block "selector" "$selector"
  if [ -n "$screenshot" ]; then
    echo "**screenshot:** $BASE/screenshots/$screenshot"
    if [ "$rect" != "null" ]; then
      echo "**rect:** \`$rect\`"
    fi
  fi
  echo
  untrusted_block "selected text" "$selected"
  echo "**user redline (trusted instruction):**"
  echo
  printf '%s\n' "$comment" | sed 's/^/> /'
  echo
  if [ -n "$surrounding" ]; then
    untrusted_block "surrounding text" "$surrounding"
  fi

  if [ "$ACK" = "1" ]; then
    node "$HTTP_CLIENT" "$PORT" POST "/redlines/$id/ack" >/dev/null
  fi
done
