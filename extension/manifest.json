{
  "manifest_version": 3,
  "name": "Redline",
  "version": "0.1.0",
  "description": "Highlight text on any page, leave a redline, pipe it to Claude Code.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:7878/*",
    "http://localhost:7878/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redline"
  }
}
