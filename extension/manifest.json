{
  "manifest_version": 3,
  "name": "Redline",
  "version": "0.2.6",
  "description": "Turn precise webpage feedback into actionable coding-agent input.",
  "icons": {
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:7878/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:7878/connect"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_icon": {
      "128": "icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Redline"
  }
}
